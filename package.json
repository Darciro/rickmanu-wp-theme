{
  "name": "rickmanu",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:css": "postcss assets/src/css/style.css -o assets/dist/css/style.css",
    "build:js": "esbuild assets/src/js/main.js --bundle --outfile=assets/dist/js/main.js --minify",
    "copy:fonts": "cp -r node_modules/@fortawesome/fontawesome-free/webfonts assets/dist/webfonts",
    "build": "npm run build:css && npm run build:js && npm run copy:fonts",
    "watch:css": "postcss assets/src/css/style.css -o assets/dist/css/style.css --watch",
    "watch:js": "esbuild assets/src/js/main.js --bundle --outfile=assets/dist/js/main.js --watch",
    "watch": "npm run copy:fonts && npm run watch:css & npm run watch:js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "autoprefixer": "^10.4.27",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "postcss-url": "^10.1.4",
    "tailwindcss": "^4.2.1"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.14",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "gsap": "^3.15.0",
    "swiper": "^12.1.3",
    "theaterjs": "^3.2.0"
  }
}
